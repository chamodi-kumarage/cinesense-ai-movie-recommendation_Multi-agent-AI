CALENDAR_DEFAULT_DAY_END=24

# Step 7 admin / media / security
ADMIN_EMAIL=admin@cinesense.ai
ADMIN_PASSWORD=CineSenseAdmin!2026
PUBLIC_API_URL=http://localhost:8000
MAX_UPLOAD_MB=5
LOGIN_MAX_FAILURES=5
