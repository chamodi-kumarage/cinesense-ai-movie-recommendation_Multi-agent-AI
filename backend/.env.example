STRIPE_FAMILY_PRICE_ID=
PUBLIC_APP_URL=http://127.0.0.1:5173
ENABLE_MONITORING=true
ENABLE_SPACY_NER=false
SPACY_MODEL=en_core_web_sm
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
